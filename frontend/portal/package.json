{
  "name": "msa-template-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "ts-node --transpile-only --project tsconfig.server.json server/index.ts",
    "dev:sm": "SITE_ID=3 npm run dev",
    "dev:lg": "SITE_ID=2 npm run dev",
    "dev:smWin": "set SITE_ID=3&&npm run dev",
    "dev:lgWin": "set SITE_ID=2&&npm run dev",
    "build": "next build",
    "prebuild": "rimraf ./.next",
    "build:prodlg": "env-cmd -f ./.env.production-lg npm run build",
    "start:prodlg": "env-cmd -f ./.env.production-lg npm run start",
    "build:prodsm": "env-cmd -f ./.env.production-sm npm run build",
    "start:prodsm": "env-cmd -f ./.env.production-sm npm run start",
    "build:prodk8slg": "env-cmd -f ./.env.production-k8s-lg npm run build",
    "start:prodk8slg": "env-cmd -f ./.env.production-k8s-lg npm run start",
    "build:prodk8ssm": "env-cmd -f ./.env.production-k8s-sm npm run build",
    "start:prodk8ssm": "env-cmd -f ./.env.production-k8s-sm npm run start",
    "start": "next start",
    "lint": "eslint src",
    "test": "jest --coverage"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-react": "^12.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/styles": "^6.5.0",
    "@mui/x-data-grid": "^8.29.5",
    "@react-oauth/google": "^0.13.5",
    "axios": "^1.20.0",
    "ckeditor5": "^49.0.0",
    "cookies": "^0.9.2",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "express": "^5.3.0",
    "i18next": "^26.5.11",
    "immer": "^11.2.9",
    "multer": "^2.5.0",
    "next": "^16.4.3",
    "next-i18next": "^16.4.3",
    "notistack": "^3.0.2",
    "react": "^18.3.1",
    "react-cookie": "^8.1.2",
    "react-datepicker": "^9.1.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.9",
    "react-kakao-login": "^2.1.1",
    "recoil": "^0.7.7",
    "swiper": "^14.3.0",
    "swr": "^2.5.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/cookies": "^0.9.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "env-cmd": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
